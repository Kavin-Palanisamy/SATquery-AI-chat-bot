{
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,web/**,data/samples/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/web/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "SATQUERY_MOCK_MODEL": "1",
    "SATQUERY_ALLOW_MODEL_DOWNLOADS": "0"
  }
}
